# =====================================================
# Copy file này thành .env rồi điền giá trị thật.
#
# CẢNH BÁO: Các biến VITE_* được Vite nhúng thẳng vào bundle JS lúc build.
# Người dùng mở DevTools là đọc được toàn bộ. File này CHỈ dùng để cấu hình
# (đổi dev/staging/prod), KHÔNG phải để giấu thông tin.
# => Không bao giờ đặt secret (API key, token, mật khẩu) vào đây.
# =====================================================

# API Configuration
# API Gateway mới (self-hosted). Đổi sang localhost nếu chạy backend local.
VITE_API_BASE_URL=http://159.65.8.108:5000/api/v1

# OAuth — endpoint backend redirect sang Google
VITE_GOOGLE_LOGIN_URL=https://nexus-api-gateway.duckdns.org/api/v1/auth/google/login

# External APIs
# Danh sách ngân hàng: https://api.vietqr.io/v2/banks
VITE_VIETQR_BANKS_URL=https://api.vietqr.io/v2/banks
# Địa giới hành chính VN 2 cấp: https://34tinhthanh.com/api-docs.html
VITE_VN_LOCATION_API_URL=https://34tinhthanh.com/api

# App Configuration
VITE_APP_NAME=Auction House
VITE_APP_VERSION=1.0.0

# Environment
VITE_ENV=development
